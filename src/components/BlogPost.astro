---
import Layout from '../layouts/Layout.astro';
import { getCopy, type Locale } from '../data/site';
import { formatBlogDate, type BlogEntry } from '../lib/blog';
import { localizedUrl } from '../lib/urls';

interface Props {
	locale: Locale;
	slug: string;
	post?: BlogEntry;
	fallbackPost?: BlogEntry;
}

const { locale, slug, post, fallbackPost } = Astro.props;
const copy = getCopy(locale);
const pageTitle = post
	? post.data.title + ' | ' + copy.writing.metaTitle
	: copy.writing.translationPendingTitle + ' | ' + copy.writing.metaTitle;
const pageDescription = post?.data.description ?? copy.writing.translationPendingText;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	pagePath={'blog/' + slug}
	noindex={!post}
>
	<main class="blog-post-page reading-column">
		<article class="blog-post">
			<header class="blog-post__header">
				<p class="eyebrow">{post ? copy.writing.postLabel : copy.writing.translationPendingLabel}</p>
				<h1>{post?.data.title ?? copy.writing.translationPendingTitle}</h1>
				{post && <p class="blog-post__description">{post.data.description}</p>}
				{post && (
					<time class="blog-post__date" datetime={post.data.date.toISOString().slice(0, 10)}>
						{formatBlogDate(post.data.date, locale)}
					</time>
				)}
			</header>

			{post ? (
				<div class="blog-post__content">
					<slot />
				</div>
			) : (
				<div class="blog-post__content blog-post__content--placeholder">
					<p>{copy.writing.translationPendingText}</p>
					{fallbackPost && (
						<a class="button-link button-link--quiet" href={localizedUrl('en', 'blog/' + slug)}>
							{copy.writing.readEnglish} <span aria-hidden="true">→</span>
						</a>
					)}
				</div>
			)}

			<footer class="blog-post__footer">
				<a href={localizedUrl(locale, 'blog')}>{copy.writing.backToBlog} <span aria-hidden="true">→</span></a>
			</footer>
		</article>
	</main>

	<style>
		.blog-post-page {
			padding-top: clamp(2rem, 7vw, 5rem);
		}

		.blog-post__header {
			padding-bottom: 3rem;
			border-bottom: 1px solid var(--color-border);
		}

		.blog-post h1 {
			margin: 0;
			font-size: clamp(3rem, 7vw, 5.5rem);
			font-weight: 500;
			letter-spacing: -0.02em;
			line-height: 0.95;
		}

		.blog-post__description {
			max-width: 42rem;
			margin: 1.5rem 0 1rem;
			font-size: clamp(1.05rem, 2vw, 1.3rem);
			line-height: 1.5;
		}

		.blog-post__date {
			color: var(--color-muted);
			font-size: 0.9rem;
		}

		.blog-post__content {
			padding: 3rem 0;
		}

		.blog-post__content :global(h2) {
			margin: 3.5rem 0 1rem;
			font-size: clamp(1.6rem, 4vw, 2.25rem);
			letter-spacing: -0.04em;
			line-height: 1.2;
		}

		.blog-post__content :global(h3) {
			margin: 2.5rem 0 0.75rem;
			font-size: 1.3rem;
			line-height: 1.3;
		}

		.blog-post__content :global(p),
		.blog-post__content :global(ul),
		.blog-post__content :global(ol) {
			margin-block: 1rem;
		}

		.blog-post__content :global(ul),
		.blog-post__content :global(ol) {
			padding-left: 1.25rem;
		}

		.blog-post__content :global(blockquote) {
			margin: 2rem 0;
			padding-left: 1rem;
			border-left: 2px solid var(--color-accent);
			color: var(--color-muted);
		}

		.blog-post__content--placeholder {
			min-height: 14rem;
		}

		.blog-post__footer {
			padding: 1rem 0 2rem;
			border-top: 1px solid var(--color-border);
		}

		.blog-post__footer a {
			font-weight: 700;
			text-decoration: none;
		}

		.blog-post__footer a:hover,
		.blog-post__footer a:focus-visible {
			color: var(--color-accent);
		}

		@media (max-width: 620px) {
			.blog-post__header {
				padding-bottom: 2rem;
			}

			.blog-post__content {
				padding-block: 2rem;
			}

			.blog-post h1 {
				font-size: clamp(2.75rem, 14vw, 4.5rem);
			}

			.blog-post__content :global(h2) {
				margin-top: 2.5rem;
			}
		}
	</style>
</Layout>
