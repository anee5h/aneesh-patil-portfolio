---
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
---

<header class="site-header">
	<!-- Add your brand or logo here. -->

	<a href={getRelativeLocaleUrl(locale, '')} aria-label="Aneesh Patil home">anee5h</a>

	<nav aria-label="Primary navigation">
		<a href={getRelativeLocaleUrl(locale, 'projects')}>Projects</a>
		<a href={getRelativeLocaleUrl(locale, 'blog')}>Blog</a>
		<a href={getRelativeLocaleUrl(locale, 'about')}>About</a>
	</nav>

	<nav aria-label="Language selection">
		<a href={getRelativeLocaleUrl('en', '')} lang="en">EN</a>
		<a href={getRelativeLocaleUrl('ja', '')} lang="ja">日本語</a>
	</nav>

	<style>
	.site-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: 1100px;
		margin: 0 auto;
		padding: 1.5rem 2rem;
	}

	.site-header > a {
		justify-self: start;
		font-size: 1.25rem;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
	}

	.site-header nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.site-header nav[aria-label='Primary navigation'] {
		justify-self: center;
	}

	.site-header nav[aria-label='Language selection'] {
		justify-self: end;
		gap: 0.75rem;
	}

	.site-header nav a {
		color: inherit;
		text-decoration: none;
	}

	.site-header nav a:hover,
	.site-header nav a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (max-width: 650px) {
		.site-header {
			grid-template-columns: 1fr auto;
			row-gap: 1rem;
			padding: 1.25rem;
		}

		.site-header nav[aria-label='Primary navigation'] {
			grid-column: 1 / -1;
			justify-self: start;
			flex-wrap: wrap;
		}
	}
</style>
</header>
