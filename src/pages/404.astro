---
import Layout from '../layouts/Layout.astro';
import { getCopy } from '../data/site';

const copy = getCopy('en');
---

<Layout title={`${copy.notFound.title} | Aneesh Patil`} description={copy.notFound.text} noindex>
	<main class="not-found page-shell">
		<p class="eyebrow">404</p>
		<h1>{copy.notFound.title}</h1>
		<p>{copy.notFound.text}</p>
		<p lang="ja">{copy.notFound.jaText}</p>
		<div class="not-found__links">
			<a class="button-link" href="/en/">English home</a>
			<a class="button-link button-link--quiet" href="/ja/">日本語のホーム</a>
		</div>
	</main>
	<style>
		.not-found {
			max-width: 48rem;
			padding-top: clamp(5rem, 15vw, 12rem);
			padding-bottom: clamp(5rem, 15vw, 12rem);
		}

		.not-found h1 {
			margin: 0;
			font-size: clamp(3rem, 7vw, 5.5rem);
			letter-spacing: -0.06em;
			line-height: 0.95;
		}

		.not-found p:not(.eyebrow) {
			max-width: 35rem;
			margin: 1.5rem 0 0;
			font-size: 1.2rem;
		}

		.not-found__links {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 2rem;
		}
	</style>
</Layout>
