---
import ProjectCard from '../../../components/ProjectCard.astro';
import Layout from '../../../layouts/Layout.astro';
import { getCopy } from '../../../data/site';
import { getPublicProjects } from '../../../lib/projects';

const locale = 'ja';
const copy = getCopy(locale);
const projects = await getPublicProjects(locale);
---

<Layout title={copy.work.metaTitle} description={copy.work.metaDescription} pagePath="projects">
	<main class="work-page page-shell">
		<header class="page-intro">
			<h1>{copy.work.title}</h1>
		</header>

		<section class="work-list" aria-label={copy.work.title}>
			{projects.length > 0 ? projects.map((project, index) => (
				<ProjectCard project={project} locale={locale} featured={index === 0} />
			)) : <p class="empty-state">{copy.work.empty}</p>}
		</section>
	</main>

	<style>
		.work-page {
			padding-top: clamp(2.5rem, 8vw, 6rem);
		}

		.page-intro {
			max-width: 46rem;
			padding-bottom: clamp(2rem, 5vw, 3rem);
		}

		.page-intro h1 {
			margin: 0;
			font-size: clamp(3rem, 7vw, 5.5rem);
			letter-spacing: -0.06em;
			line-height: 1.05;
		}

		.work-list {
			padding-bottom: 2rem;
		}

		.empty-state {
			padding: 2rem 0;
			border-top: 1px solid var(--color-border);
			color: var(--color-muted);
		}
	</style>
</Layout>
