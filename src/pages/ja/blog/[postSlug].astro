---
import { render, type CollectionEntry } from 'astro:content';
import BlogPost from '../../../components/BlogPost.astro';
import { getPublicBlogEntries } from '../../../lib/blog';

const locale = 'ja' as const;

export async function getStaticPaths() {
	const locale = 'ja' as const;
	const entries = await getPublicBlogEntries();
	const slugs = [...new Set(entries.map((entry) => entry.data.translationKey))];

	return slugs.map((slug) => ({
		params: { postSlug: slug },
		props: {
			slug,
			post: entries.find((entry) => entry.data.locale === locale && entry.data.translationKey === slug),
			fallbackPost: entries.find((entry) => entry.data.locale === 'en' && entry.data.translationKey === slug),
		},
	}));
}

const { slug, post, fallbackPost } = Astro.props as {
	slug: string;
	post?: CollectionEntry<'blog'>;
	fallbackPost?: CollectionEntry<'blog'>;
};
const content = post ? await render(post) : undefined;
const Content = content?.Content;
---

{Content ? (
	<BlogPost locale={locale} slug={slug} post={post} fallbackPost={fallbackPost}>
		<Content />
	</BlogPost>
) : (
	<BlogPost locale={locale} slug={slug} fallbackPost={fallbackPost} />
)}
