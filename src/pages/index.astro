<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Aneesh Patil</title>
		<noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
	</head>
	<body>
		<p>Choose a language: <a href="/en/">English</a> · <a href="/ja/" lang="ja">日本語</a></p>
		<script is:inline>
			const isJapanese = /^(?:ja)(?:-|$)/i.test(navigator.language);
			window.location.replace(isJapanese ? '/ja/' : '/en/');
		</script>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		--entry-background: #edf1ee;
		--entry-ink: #252b27;
		--entry-accent: #95612f;
		color-scheme: light;
		margin: 0;
		min-height: 100%;
		background: var(--entry-background);
		color: var(--entry-ink);
		font-family: ui-sans-serif, system-ui, sans-serif;
	}

	@media (prefers-color-scheme: dark) {
		:global(html),
		:global(body) {
			--entry-background: #1b1d1a;
			--entry-ink: #e8e2d7;
			--entry-accent: #d29a5c;
			color-scheme: dark;
		}
	}

	body {
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 1.5rem;
	}

	a {
		color: var(--entry-accent);
	}
</style>
