<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Aneesh Patil</title>
		<noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
	</head>
	<body>
		<p>Choose a language: <a href="/en/">English</a> · <a href="/ja/" lang="ja">日本語</a></p>
		<script is:inline>
			const isJapanese = /^(?:ja)(?:-|$)/i.test(navigator.language);
			window.location.replace(isJapanese ? '/ja/' : '/en/');
		</script>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		min-height: 100%;
		background: #1b1d1a;
		color: #e8e2d7;
		font-family: ui-sans-serif, system-ui, sans-serif;
	}

	body {
		display: grid;
		min-height: 100vh;
		place-items: center;
		padding: 1.5rem;
	}

	a {
		color: #d6ab43;
	}
</style>
